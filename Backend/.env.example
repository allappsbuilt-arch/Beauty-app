PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Supabase → Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase → Settings → API → Project API keys → anon / public
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# OpenAI → https://platform.openai.com/api-keys (powers face scans, label reading, style recommendations)
OPENAI_API_KEY=sk-...
# Optional: any vision model that supports Structured Outputs
OPENAI_MODEL=gpt-4o-mini
