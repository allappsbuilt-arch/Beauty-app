{
  "expo": {
    "name": "BeautyApp",
    "slug": "beautyapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FFF0F3"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.qwedx123.beautyapp",
      "adaptiveIcon": {
        "backgroundColor": "#FFF0F3"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "9cd14e8f-2994-46af-96ca-1e0a2fa98f7d"
      }
    },
    "owner": "qwedx123"
  }
}
